<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9 (API 28) and above block plain HTTP by default. The Ktor server runs
    over HTTP on a laptop, so the specific hosts it lives on must be allowed.

    This is scoped to development addresses only - the app still refuses cleartext
    to anywhere else, which is what you want. Do not switch to a blanket
    android:usesCleartextTraffic="true" on the application tag.

    10.0.2.2  - the host machine, as seen from the Android emulator
    127.0.0.1 - only useful when the server runs on the device itself
    Add your laptop's LAN IP here when testing on a physical phone.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
