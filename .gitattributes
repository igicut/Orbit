# Normalizuje kraj reda, isto na svim OS

* text=auto eol=lf

# gradlew mora LF, inace puca na Linux-u
gradlew text eol=lf
*.sh text eol=lf

# Batch fajlovi traze CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarni fajlovi bez konverzije i text diff-a
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.docx binary
*.pdf binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.mv.db binary

# Tekst, ali citljiv diff
*.kt text
*.kts text
*.java text
*.xml text
*.md text
*.yaml text
*.yml text
*.toml text
*.properties text
*.pro text
